generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─── AUTH (NextAuth) ──────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── USERS ────────────────────────────────────────────────────────────────────

enum ProfileVisibility {
  PUBLIC
  FRIENDS
  PRIVATE
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model User {
  id            String            @id @default(cuid())
  name          String?
  email         String?           @unique
  emailVerified DateTime?
  image         String?
  steamId       String?           @unique
  steamName     String?
  steamAvatar   String?
  customAvatar  String?
  bio           String?           @db.Text
  theme         String            @default("system")
  visibility    ProfileVisibility @default(PUBLIC)
  discordId     String?           @unique
  discordName   String?
  discordAvatar String?
  isEagleVanguardTeam  Boolean           @default(false)
  isBannedFromPlatform Boolean           @default(false)
  eagleVanguardRankId  String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  accounts           Account[]
  sessions           Session[]
  memberships        Membership[]
  applications       Application[]
  createdCommunities Community[]       @relation("CommunityCreator")
  events             EventParticipant[]
  steamAuthCodes     SteamAuthCode[]
  sentFriendRequests     Friendship[]  @relation("SentRequests")
  receivedFriendRequests Friendship[]  @relation("ReceivedRequests")
  notifications      Notification[]
  rpCharacters       RpCharacter[]
  posts              CommunityPost[]
  eagleVanguardRank      EagleVanguardRank?  @relation("UserRole", fields: [eagleVanguardRankId], references: [id], onDelete: SetNull)
  eagleVanguardFunctions EagleVanguardRank[] @relation("UserFunctions")
  moderationTarget   ModerationAction[] @relation("ModTarget")
  moderationActed    ModerationAction[] @relation("ModActor")
  moderationResolved ModerationAction[] @relation("ModResolver")
  auditLogsAsActor   AuditLog[]         @relation("AuditActor")
  auditLogsAsTarget  AuditLog[]         @relation("AuditTarget")
  conversations1     Conversation[]     @relation("ConversationUser1")
  conversations2     Conversation[]     @relation("ConversationUser2")
  sentMessages       Message[]
  blocksGiven        Block[]            @relation("BlocksGiven")
  blocksReceived     Block[]            @relation("BlocksReceived")
}

// ─── EAGLE VANGUARD TEAM ─────────────────────────────────────────────────────

model EagleVanguardRank {
  id           String   @id @default(cuid())
  name         String
  abbreviation String
  order        Int
  color        String   @default("#6366f1")
  permissions  String[]
  isProtected  Boolean  @default(false)
  category     String   @default("ROLE")
  createdAt    DateTime @default(now())

  users          User[]  @relation("UserRole")
  functionUsers  User[]  @relation("UserFunctions")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  receiverId  String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester User @relation("SentRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver  User @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@index([receiverId, status])
}

model SteamAuthCode {
  id        String   @id @default(cuid())
  code      String   @unique
  userId    String
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

// ─── COMMUNITIES ──────────────────────────────────────────────────────────────

enum CommunityVisibility {
  PUBLIC     // visible dans l'annuaire, rejoindre sans candidature
  WHITELIST  // visible dans l'annuaire, candidature requise
  INVISIBLE  // non visible dans l'annuaire (sauf membres + Eagle Vanguard Team)
}

model Community {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique
  description String?             @db.Text
  logoUrl     String?
  bannerUrl   String?
  game        String              @default("ARMA 3")
  language    String              @default("fr")
  visibility  CommunityVisibility @default(WHITELIST)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  creatorId   String

  discordGuildId  String?

  creator      User          @relation("CommunityCreator", fields: [creatorId], references: [id])
  memberships  Membership[]
  ranks        Rank[]
  units        Unit[]
  orbat        OrbatNode[]
  orbatEdges   OrbatEdge[]
  events         Event[]
  applications   Application[]
  rpUnits        RpUnit[]
  rpCharacters   RpCharacter[]
  rpGroups       RpGroup[]
  posts          CommunityPost[]
  eventTemplates EventTemplate[]
  moderationActions ModerationAction[]
  auditLogs         AuditLog[]
}

enum MemberRole {
  OWNER
  MEMBER
  RECRUIT
}

model Membership {
  id          String     @id @default(cuid())
  userId      String
  communityId String
  role        MemberRole @default(RECRUIT)
  rankId      String?
  unitId      String?
  joinedAt    DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  rank      Rank?     @relation(fields: [rankId], references: [id])
  unit      Unit?     @relation(fields: [unitId], references: [id])

  @@unique([userId, communityId])
}

// ─── RANKS ────────────────────────────────────────────────────────────────────

model Rank {
  id          String   @id @default(cuid())
  communityId String
  name        String
  order       Int
  color       String   @default("#6366f1")
  permissions String[]
  iconUrl     String?
  isPermanent Boolean  @default(false)

  community   Community    @relation(fields: [communityId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@index([communityId])
}

// ─── UNITS (ORBAT) ────────────────────────────────────────────────────────────

model Unit {
  id          String  @id @default(cuid())
  communityId String
  name        String
  type        String
  parentId    String?
  callsign    String?
  description String? @db.Text

  community   Community    @relation(fields: [communityId], references: [id], onDelete: Cascade)
  parent      Unit?        @relation("UnitHierarchy", fields: [parentId], references: [id])
  children    Unit[]       @relation("UnitHierarchy")
  memberships Membership[]
}

model OrbatNode {
  id          String  @id @default(cuid())
  communityId String
  nodeId      String
  type        String
  label       String
  positionX   Float
  positionY   Float
  locked      Boolean @default(false)
  data        Json?

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([communityId, nodeId])
}

model OrbatEdge {
  id          String @id @default(cuid())
  communityId String
  edgeId      String
  source      String
  target      String
  data        Json?

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([communityId, edgeId])
}

// ─── ORBAT PAR UNITÉ RP ───────────────────────────────────────────────────────

model RpUnitOrbatNode {
  id        String  @id @default(cuid())
  rpUnitId  String
  nodeId    String
  type      String
  label     String
  positionX Float
  positionY Float
  locked    Boolean @default(false)
  data      Json?

  rpUnit RpUnit @relation(fields: [rpUnitId], references: [id], onDelete: Cascade)

  @@unique([rpUnitId, nodeId])
}

model RpUnitOrbatEdge {
  id       String @id @default(cuid())
  rpUnitId String
  edgeId   String
  source   String
  target   String
  data     Json?

  rpUnit RpUnit @relation(fields: [rpUnitId], references: [id], onDelete: Cascade)

  @@unique([rpUnitId, edgeId])
}

// ─── EVENTS ───────────────────────────────────────────────────────────────────

enum EventStatus {
  DRAFT
  PUBLISHED
  ONGOING
  COMPLETED
  CANCELLED
  ARCHIVED
}

model Event {
  id             String      @id @default(cuid())
  communityId    String
  title          String
  description    String?     @db.Text
  type           String
  status         EventStatus @default(DRAFT)
  startDate      DateTime
  endDate        DateTime?
  maxSlots       Int?
  imageUrl       String?
  source         String      @default("Eagle Vanguard")
  discordEventId String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  community    Community          @relation(fields: [communityId], references: [id], onDelete: Cascade)
  participants EventParticipant[]

  @@unique([communityId, discordEventId])
  @@index([communityId, status, startDate])
}

enum ParticipantStatus {
  CONFIRMED
  TENTATIVE
  DECLINED
}

model EventParticipant {
  id       String            @id @default(cuid())
  eventId  String
  userId   String
  status   ParticipantStatus @default(TENTATIVE)
  role     String?
  joinedAt DateTime          @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

// ─── ROSTER RP ────────────────────────────────────────────────────────────────

model RpUnit {
  id           String        @id @default(cuid())
  communityId  String
  name         String
  description  String?       @db.Text
  era          String?
  game         String?
  columnConfig Json?
  createdAt    DateTime      @default(now())

  community   Community          @relation(fields: [communityId], references: [id], onDelete: Cascade)
  characters  RpCharacter[]
  rpGroups    RpGroup[]
  orbatNodes  RpUnitOrbatNode[]
  orbatEdges  RpUnitOrbatEdge[]

  @@index([communityId])
}

model RpGroup {
  id          String        @id @default(cuid())
  communityId String
  rpUnitId    String
  name        String
  order       Int           @default(0)
  createdAt   DateTime      @default(now())

  community   Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  rpUnit      RpUnit        @relation(fields: [rpUnitId], references: [id], onDelete: Cascade)
  characters  RpCharacter[]
}

model RpCharacter {
  id          String    @id @default(cuid())
  communityId String
  userId      String
  rpUnitId    String?
  rpGroupId   String?
  name         String
  grade        String?
  role         String?
  customFields Json?
  description  String?   @db.Text
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  community Community  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  rpUnit    RpUnit?    @relation(fields: [rpUnitId], references: [id], onDelete: Cascade)
  rpGroup   RpGroup?   @relation(fields: [rpGroupId], references: [id], onDelete: SetNull)

  @@unique([rpUnitId, userId])
  @@index([communityId, userId])
}

// ─── COMMUNITY POSTS ──────────────────────────────────────────────────────────

model CommunityPost {
  id          String   @id @default(cuid())
  communityId String
  authorId    String
  title       String
  content     String   @db.Text
  isPinned    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([communityId, createdAt])
}

// ─── EVENT TEMPLATES ──────────────────────────────────────────────────────────

model EventTemplate {
  id          String   @id @default(cuid())
  communityId String
  name        String
  title       String
  type        String
  description String?  @db.Text
  maxSlots    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([communityId])
}

// ─── AUDIT LOGS ───────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  description String
  actorId     String?
  targetId    String?
  communityId String?
  metadata    Json?
  createdAt   DateTime @default(now())

  actor     User?      @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  target    User?      @relation("AuditTarget", fields: [targetId], references: [id], onDelete: SetNull)
  community Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([communityId, createdAt])
  @@index([actorId])
  @@index([action])
}

// ─── MODERATION ───────────────────────────────────────────────────────────────

enum ModerationActionType {
  WARN
  KICK
  BAN_COMMUNITY
  BAN_PLATFORM
  UNBAN
}

model ModerationAction {
  id           String               @id @default(cuid())
  type         ModerationActionType
  reason       String               @db.Text
  targetId     String
  moderatorId  String
  communityId  String?
  expiresAt    DateTime?
  resolvedAt   DateTime?
  resolvedById String?
  note         String?              @db.Text
  createdAt    DateTime             @default(now())

  target     User       @relation("ModTarget", fields: [targetId], references: [id], onDelete: Cascade)
  moderator  User       @relation("ModActor", fields: [moderatorId], references: [id], onDelete: Cascade)
  community  Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
  resolvedBy User?      @relation("ModResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([targetId])
  @@index([communityId, createdAt])
  @@index([moderatorId])
}

// ─── MESSAGERIE ───────────────────────────────────────────────────────────────

model Conversation {
  id              String   @id @default(cuid())
  user1Id         String
  user2Id         String
  deletedByUser1  Boolean  @default(false)
  deletedByUser2  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user1    User      @relation("ConversationUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2    User      @relation("ConversationUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([user1Id, user2Id])
  @@index([user1Id, updatedAt])
  @@index([user2Id, updatedAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String   @db.Text
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlocksGiven", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

// ─── APPLICATIONS ─────────────────────────────────────────────────────────────

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model Application {
  id          String            @id @default(cuid())
  communityId String
  userId      String
  status      ApplicationStatus @default(PENDING)
  message     String?           @db.Text
  response    String?           @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([communityId, status])
}
