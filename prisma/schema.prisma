generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─── AUTH (NextAuth) ──────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── USERS ────────────────────────────────────────────────────────────────────

enum ProfileVisibility {
  PUBLIC
  FRIENDS
  PRIVATE
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model User {
  id            String            @id @default(cuid())
  name          String?
  email         String?           @unique
  emailVerified DateTime?
  image         String?
  steamId       String?           @unique
  steamName     String?
  steamAvatar   String?
  customAvatar  String?
  bio           String?           @db.Text
  theme         String            @default("system")
  visibility    ProfileVisibility @default(PUBLIC)
  discordId     String?           @unique
  discordName   String?
  discordAvatar String?
  isNexusTeam   Boolean           @default(false)
  nexusRankId   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  accounts           Account[]
  sessions           Session[]
  memberships        Membership[]
  applications       Application[]
  createdCommunities Community[]       @relation("CommunityCreator")
  events             EventParticipant[]
  steamAuthCodes     SteamAuthCode[]
  sentFriendRequests     Friendship[]  @relation("SentRequests")
  receivedFriendRequests Friendship[]  @relation("ReceivedRequests")
  notifications      Notification[]
  rpCharacters       RpCharacter[]
  posts              CommunityPost[]
  nexusRank          NexusRank?        @relation("UserRole", fields: [nexusRankId], references: [id], onDelete: SetNull)
  nexusFunctions     NexusRank[]       @relation("UserFunctions")
}

// ─── NEXUS TEAM ───────────────────────────────────────────────────────────────

model NexusRank {
  id           String   @id @default(cuid())
  name         String
  abbreviation String
  order        Int
  color        String   @default("#6366f1")
  isProtected  Boolean  @default(false)
  category     String   @default("ROLE")
  createdAt    DateTime @default(now())

  users          User[]  @relation("UserRole")
  functionUsers  User[]  @relation("UserFunctions")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  receiverId  String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester User @relation("SentRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver  User @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@index([receiverId, status])
}

model SteamAuthCode {
  id        String   @id @default(cuid())
  code      String   @unique
  userId    String
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

// ─── COMMUNITIES ──────────────────────────────────────────────────────────────

model Community {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  logoUrl     String?
  bannerUrl   String?
  game        String   @default("ARMA 3")
  language    String   @default("fr")
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  creatorId   String

  creator      User          @relation("CommunityCreator", fields: [creatorId], references: [id])
  memberships  Membership[]
  ranks        Rank[]
  units        Unit[]
  orbat        OrbatNode[]
  orbatEdges   OrbatEdge[]
  events       Event[]
  applications Application[]
  rpUnits      RpUnit[]
  rpCharacters RpCharacter[]
  rpGroups     RpGroup[]
  posts        CommunityPost[]
}

enum MemberRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
  RECRUIT
}

model Membership {
  id          String     @id @default(cuid())
  userId      String
  communityId String
  role        MemberRole @default(RECRUIT)
  rankId      String?
  unitId      String?
  joinedAt    DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  rank      Rank?     @relation(fields: [rankId], references: [id])
  unit      Unit?     @relation(fields: [unitId], references: [id])

  @@unique([userId, communityId])
}

// ─── RANKS ────────────────────────────────────────────────────────────────────

model Rank {
  id           String  @id @default(cuid())
  communityId  String
  name         String
  abbreviation String
  order        Int
  color        String  @default("#6366f1")
  iconUrl      String?
  isPermanent  Boolean @default(false)

  community   Community    @relation(fields: [communityId], references: [id], onDelete: Cascade)
  memberships Membership[]
}

// ─── UNITS (ORBAT) ────────────────────────────────────────────────────────────

model Unit {
  id          String  @id @default(cuid())
  communityId String
  name        String
  type        String
  parentId    String?
  callsign    String?
  description String? @db.Text

  community   Community    @relation(fields: [communityId], references: [id], onDelete: Cascade)
  parent      Unit?        @relation("UnitHierarchy", fields: [parentId], references: [id])
  children    Unit[]       @relation("UnitHierarchy")
  memberships Membership[]
}

model OrbatNode {
  id          String @id @default(cuid())
  communityId String
  nodeId      String
  type        String
  label       String
  positionX   Float
  positionY   Float
  data        Json?

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([communityId, nodeId])
}

model OrbatEdge {
  id          String @id @default(cuid())
  communityId String
  edgeId      String
  source      String
  target      String
  data        Json?

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([communityId, edgeId])
}

// ─── EVENTS ───────────────────────────────────────────────────────────────────

enum EventStatus {
  DRAFT
  PUBLISHED
  ONGOING
  COMPLETED
  CANCELLED
  ARCHIVED
}

model Event {
  id          String      @id @default(cuid())
  communityId String
  title       String
  description String?     @db.Text
  type        String
  status      EventStatus @default(DRAFT)
  startDate   DateTime
  endDate     DateTime?
  maxSlots    Int?
  imageUrl    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  community    Community          @relation(fields: [communityId], references: [id], onDelete: Cascade)
  participants EventParticipant[]
}

enum ParticipantStatus {
  CONFIRMED
  TENTATIVE
  DECLINED
}

model EventParticipant {
  id       String            @id @default(cuid())
  eventId  String
  userId   String
  status   ParticipantStatus @default(TENTATIVE)
  role     String?
  joinedAt DateTime          @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

// ─── ROSTER RP ────────────────────────────────────────────────────────────────

model RpUnit {
  id          String        @id @default(cuid())
  communityId String
  name        String
  description String?       @db.Text
  era         String?
  createdAt   DateTime      @default(now())

  community   Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  characters  RpCharacter[]
  rpGroups    RpGroup[]
}

model RpGroup {
  id          String        @id @default(cuid())
  communityId String
  rpUnitId    String
  name        String
  order       Int           @default(0)
  createdAt   DateTime      @default(now())

  community   Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  rpUnit      RpUnit        @relation(fields: [rpUnitId], references: [id], onDelete: Cascade)
  characters  RpCharacter[]
}

model RpCharacter {
  id          String    @id @default(cuid())
  communityId String
  userId      String
  rpUnitId    String?
  rpGroupId   String?
  name        String
  role        String?
  description String?   @db.Text
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  community Community  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  rpUnit    RpUnit?    @relation(fields: [rpUnitId], references: [id], onDelete: Cascade)
  rpGroup   RpGroup?   @relation(fields: [rpGroupId], references: [id], onDelete: SetNull)

  @@unique([rpUnitId, userId])
}

// ─── COMMUNITY POSTS ──────────────────────────────────────────────────────────

model CommunityPost {
  id          String   @id @default(cuid())
  communityId String
  authorId    String
  title       String
  content     String   @db.Text
  isPinned    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([communityId, createdAt])
}

// ─── APPLICATIONS ─────────────────────────────────────────────────────────────

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model Application {
  id          String            @id @default(cuid())
  communityId String
  userId      String
  status      ApplicationStatus @default(PENDING)
  message     String?           @db.Text
  response    String?           @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
}
